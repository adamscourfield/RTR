# Enables Claude-powered lesson analysis. Without it, RTR uses the built-in pattern engine.
ANTHROPIC_API_KEY=
# Optional model override
# RTR_MODEL=claude-opus-5

# Enables audio transcription (live recordings and audio-file import) with speaker
# diarization, via AssemblyAI. Without it, live mode falls back to the browser's own
# (non-diarizing) speech recognition, and audio-file import is unavailable.
ASSEMBLYAI_API_KEY=
